{
  "name": "agri-agentic-suite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:windows": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "setup": "bash scripts/setup.sh",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "web:dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "health": "bash scripts/health.sh",
    "doctor": "bash scripts/doctor.sh",
    "doctor:windows": "powershell -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "restart": "bash scripts/restart.sh",
    "restart:windows": "powershell -ExecutionPolicy Bypass -File scripts/restart.ps1",
    "tg:poll": "python3 scripts/tg-poll.py",
    "tg:poll:windows": "powershell -ExecutionPolicy Bypass -File scripts/tg-poll.ps1",
    "setup:telegram": "bash scripts/setup-telegram.sh",
    "test": "uv run python -m pytest",
    "python:check": "uv run ruff check services"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "2.117.3",
    "mic-recorder-to-mp3": "2.2.2",
    "next": "15.4.10",
    "react": "19.1.5",
    "react-dom": "19.1.5",
    "react-markdown": "10.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.4.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
