# Copy this file to .env. Never commit .env or real credentials.
# Supabase project: Krish (never expose the secret/service-role key to the browser)
SUPABASE_URL=https://arzoxzvzjlphnqalsxhd.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
SUPABASE_SECRET_KEY=replace-with-secret-or-service-role-key
# Use the Supabase transaction pooler URI from Connect > ORMs. Escape special
# password characters with URL encoding. This direct DB credential is backend-only.
SUPABASE_DB_URL=postgresql+psycopg2://postgres.project-ref:password@pooler-host:6543/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://arzoxzvzjlphnqalsxhd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key

# Application security
SECRET_KEY=generate-a-long-random-value
INTERNAL_API_KEY=generate-a-different-long-random-value
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
UPSTREAM_TIMEOUT_SECONDS=180

# Disease vision: LOCAL YOLOv11x detector on GPU (MODEL_DIR/yolo11-plant/).
# No Ollama VLM in the hot path. `local:` prefix = never pull from Ollama registry.
VISION_MODEL=local:yolo11x-plant
# Text LLM: farm-tuned qwen2.5-3b (num_ctx 4096, full GPU offload).
# Create after pulling base: ollama create qwen25-3b-farm -f .local/models/Modelfile.farm-q4
LOCAL_LLM_MODEL=qwen25-3b-farm
OLLAMA_API_BASE_URL=http://ollama:11434
# VRAM guard: 1 model resident at a time, sequential requests, evict idle after 5m.
# Applies whenever an Ollama text model is reintroduced.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
EMBEDDING_MODEL_NAME=paraphrase-MiniLM-L3-v2
HF_HOME=/shared/hf_cache

# External data (optional)
DATA_GOV_API_KEY=
TRAIN_PRICE_MODEL_ON_STARTUP=false
NEWS_FEED_URLS=
NEWS_REFRESH_MINUTES=30

# Telegram (optional until configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

ENVIRONMENT=development
